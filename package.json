{
  "name": "fit-thetic-gym",
  "productName": "Fit-Thetic Fitness Club",
  "appId": "pk.fit-thetic.gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:portable": "npm run build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "pk.fit-thetic.gym",
    "productName": "Fit-Thetic Gym Management",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fit-Thetic Gym Management"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "mongodb": "^7.5.0",
    "papaparse": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^40.8.0",
    "electron-builder": "^26.7.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
